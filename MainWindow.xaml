<Window x:Class="NerdGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NerdGame"
        mc:Ignorable="d"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Title="NerdGame" Height="450" Width="800">

    <Grid Margin="25">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Width="600">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Label x:Name="GameStateLabel" Content="Ready" FontSize="18" FontWeight="Bold" Margin="5"/>
                <Label x:Name="TimeLabel" Content="Time: 10" FontSize="18" Margin="5"/>
                <Button x:Name="NewGameButton" Content="New Game" Width="100" Margin="5" Click="NewGameButton_Click"/>
                <ComboBox x:Name="ThemeSelector" Width="120" Margin="10" SelectionChanged="ThemeSelector_SelectionChanged">
                    <ComboBoxItem Content="Light" IsSelected="True"/>
                    <ComboBoxItem Content="Dark"/>
                </ComboBox>

            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                <Label Content="Target:" FontSize="18" VerticalAlignment="Center" Margin="5"/>
                <Label x:Name="TargetValueLabel" Content="??" FontSize="18" FontWeight="Bold" Width="60" VerticalAlignment="Center" Margin="5"/>
                <RadioButton x:Name="HexRadio" Content="Hex" IsChecked="True" Margin="20,0,0,0"/>
                <RadioButton x:Name="DecimalRadio" Content="Decimal" Margin="10,0,0,0"/>
            </StackPanel>

            <local:BinaryInputControl x:Name="BinaryInput" HorizontalAlignment="Center" Margin="0,30,0,0" Height="60" Width="600"/>

        </StackPanel>
    </Grid>
</Window>
